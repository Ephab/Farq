{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "waypoint-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "services/api",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "waypoint-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "waypoint-stack-mac",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "run.sh"
      ],
      "port": 5173
    },
    {
      "name": "pitch",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4777",
        "--directory",
        "presentation"
      ],
      "port": 4777
    }
  ]
}
