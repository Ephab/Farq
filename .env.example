# External AI-provider credentials are supplied by you; setup cannot generate them.
GEMINI_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=
HERMES_MODEL=gemini-3.8-flash
HERMES_PROVIDER=gemini

# Generated automatically by setup. Keep existing values when upgrading.
HERMES_API_KEY=
WAYPOINT_INTERNAL_TOKEN=
WAYPOINT_TOKEN_ENCRYPTION_KEY=
# Generated only if classic Outlook is detected on native Windows. Server-only.
OUTLOOK_LOCAL_TOKEN=

OPPORTUNITY_SYNC_ENABLED=true
COOP_SYNC_ENABLED=true
COOP_TELEGRAM_ARCHIVE_ENABLED=true
COOP_TELEGRAM_ARCHIVE_URL=https://t.me/s/nobthacv1
COOP_LINKEDIN_ENABLED=true
APIFY_API_KEY=
# Optional TypeSafe/Jev decision layer. Shadow mode records decisions without changing behavior.
TYPESAFE_AI_API_KEY=
JEV_ENABLED=true
JEV_MODE=shadow
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=5
JEV_ACTIVE_PURPOSES=
# Decision-gate fallback after Jev: Respan Span-01 Lite via OpenRouter (free tier), then local Laya.
OPENROUTER_API_KEY=
SPAN_ENABLED=true
SPAN_MODEL=respan/span-01-lite
SPAN_TIMEOUT_SECONDS=10
APIFY_LINKEDIN_ACTOR_ID=hKByXkMQaC5Qt9UMN
APIFY_MAX_TOTAL_CHARGE_USD=0.06
OUTLOOK_APP_ORIGIN=http://localhost:5173
OUTLOOK_SYNC_ENABLED=true
# Email Q&A uses the same gateway as Coach (setup keeps this alias in sync).
HERMES_EMAIL_URL=http://127.0.0.1:8642

# Native project code runs with your user privileges. Enable only for trusted local submissions.
WAYPOINT_EVALUATOR_NATIVE=0

# Optional shared server for Group Projects (see docs/running-the-shared-server.md). With these empty, Group Projects
# stays local to this computer. Set the server's address and restart the app: Group Projects asks you once to confirm
# the connection, then creates your shared account automatically.
WAYPOINT_COLLAB_URL=https://hoarsely-penetralian-esperanza.ngrok-free.dev/
WAYPOINT_COLLAB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Curated public learning updates: keep off until docs/learning-updates-threat-model.md rollout checks pass.
LEARNING_UPDATES_ENABLED=false
LEARNING_UPDATES_ROLLOUT_REVIEWED=false
LEARNING_UPDATES_DAILY_BUDGET_USD=1
APIFY_LEARNING_X_ACTOR=apidojo/tweet-scraper
APIFY_LEARNING_REDDIT_ACTOR=fatihtahta/reddit-scraper-search-fast
