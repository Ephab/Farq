GEMINI_API_KEY=
NVIDIA_API_KEY=
# Hugging Face Inference Providers token (fine-grained, "Make calls to Inference Providers").
HF_TOKEN=
HERMES_API_KEY=
HERMES_MODEL=gemini-3.8-flash
HERMES_PROVIDER=gemini
FARQ_INTERNAL_TOKEN=farq-internal-dev
OPPORTUNITY_SYNC_ENABLED=true

# University Outlook: Entra Web app, delegated User.Read and Mail.Read.
# Windows classic Outlook: use desktop (no Entra registration). Use graph elsewhere.
OUTLOOK_PROVIDER=desktop
# Use the frontend origin (Vite/nginx proxies /api). No credentials in VITE_*.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
OUTLOOK_APP_ORIGIN=http://localhost:5173
MICROSOFT_REDIRECT_URI=http://localhost:5173/api/outlook/callback
FARQ_TOKEN_ENCRYPTION_KEY=
OUTLOOK_SYNC_ENABLED=true
