# External AI-provider credentials are supplied by you; setup cannot generate them.
GEMINI_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=
HERMES_MODEL=gemini-3.8-flash
HERMES_PROVIDER=gemini

# Generated automatically by setup. Keep existing values when upgrading.
HERMES_API_KEY=
FARQ_INTERNAL_TOKEN=
FARQ_TOKEN_ENCRYPTION_KEY=
# Generated only if classic Outlook is detected on native Windows. Server-only.
OUTLOOK_LOCAL_TOKEN=

OPPORTUNITY_SYNC_ENABLED=true
OUTLOOK_APP_ORIGIN=http://localhost:5173
OUTLOOK_SYNC_ENABLED=true
# Email Q&A uses the same gateway as Coach (setup keeps this alias in sync).
HERMES_EMAIL_URL=http://127.0.0.1:8642
