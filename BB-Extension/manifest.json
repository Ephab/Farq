{
  "manifest_version": 3,
  "name": "IAU Blackboard Read-Only Extractor",
  "version": "1.1.0",
  "description": "Read-only extractor for IAU Blackboard (vle.iau.edu.sa). Uses your existing login session. No password storage, no admin approval, GET requests only.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://vle.iau.edu.sa/*"],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "IAU BB Extractor"
  },
  "content_scripts": [
    {
      "matches": ["https://vle.iau.edu.sa/*"],
      "js": ["src/bb-utils.js", "src/bb-model.js", "src/extractor.js", "src/ics.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
