# The shared server's own configuration. Loaded only from this folder; never use the personal app's DATABASE_URL.
# `python scripts/init_dev.py` writes a working .env for a local setup (random database password and signing key).
COLLAB_ENVIRONMENT=development
COLLAB_DATABASE_URL=postgresql+psycopg://waypoint:replace-me@127.0.0.1:55432/waypoint_collaboration
# Signs account tokens. Generate once and keep secret: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).rstrip(b'=').decode())"
COLLAB_DEVICE_SIGNING_KEY=replace-with-43-random-base64url-characters
# Web addresses of the app on people's computers (http loopback is only allowed in development).
COLLAB_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
COLLAB_TEAMS_ENABLED=true
# Optional: refuse app versions older than this (HTTP 426), and limit new accounts per day (default 300).
# COLLAB_MIN_CLIENT_VERSION=0.1.0
# COLLAB_DEVICE_REGISTRATIONS_PER_DAY=300

# Team Hermes (off by default). Needs a separate gateway that loads only .hermes/plugins/waypoint-team.
# COLLAB_TEAM_AI_ENABLED=true
# COLLAB_HERMES_URL=http://127.0.0.1:8643
# COLLAB_HERMES_API_KEY=generate-16-plus-random-characters
# COLLAB_HERMES_TOOL_TOKEN=generate-32-plus-random-characters   # the same value as WAYPOINT_COLLAB_TOOL_TOKEN in the gateway
